APP_NAME=Sistema de Horarios Universitarios
APP_ENV=development
APP_VERSION=1.0.0
DEBUG=true

# Estos valores coinciden con docker-compose.yml (SQL Server en contenedor,
# publicado en el puerto 14330 de Windows para no chocar con un SQL Server
# nativo que ya use el 1433). Si conectas el backend DESDE DENTRO de la red
# de Docker Compose (servicio "backend" del mismo compose), usa en cambio
# DB_SERVER=sqlserver y DB_PORT=1433.
DB_SERVER=localhost
DB_PORT=14330
DB_NAME=HorariosUniversitarios
DB_USER=sa
DB_PASSWORD=HorariosUni2026
DB_DRIVER=ODBC Driver 18 for SQL Server
DB_TRUST_SERVER_CERTIFICATE=true

CORS_ORIGINS=["http://localhost:4200"]
